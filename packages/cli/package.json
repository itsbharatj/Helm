{
  "name": "helm-robotics",
  "version": "0.1.0",
  "description": "A terminal agent for ROS2 robots — control hardware and build robot software through natural language",
  "keywords": [
    "ros2",
    "robotics",
    "cli",
    "agent",
    "llm",
    "tui",
    "terminal",
    "rclnodejs",
    "navigation",
    "slam"
  ],
  "homepage": "https://github.com/your-org/helm-robotics#readme",
  "bugs": {
    "url": "https://github.com/your-org/helm-robotics/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/helm-robotics.git"
  },
  "license": "MIT",
  "author": "Helm Robotics Contributors",
  "type": "module",
  "bin": {
    "helm": "./bin/helm.js"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    "tsconfig.json",
    "tsconfig.standalone.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@helm/agent": "workspace:*",
    "@helm/config": "workspace:*",
    "@helm/llm": "workspace:*",
    "@helm/tui": "workspace:*",
    "@iarna/toml": "^2.2.5",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.27.3",
    "typescript": "~5.9.2"
  }
}
